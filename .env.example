# Supabase authentication
# Create a project at https://supabase.com, then copy these from
# Project Settings → API into .env.local (never commit real keys).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Admin panel passcode for confirming bank transfers at /Admin
ADMIN_PASSCODE=change-me

# Supabase auth settings to match this app:
# - Authentication → URL Configuration → Site URL: your deployed origin
# - Add redirect URLs: http://localhost:3000/ResetPassword and
#   https://your-domain/ResetPassword (plus /Login for email confirmation)
